# Backend REST API. IMPORTANT: must serve a VALID TLS certificate, otherwise
# axios/fetch on real devices will reject the connection (self-signed = blocked).
EXPO_PUBLIC_API_URL=https://yala.dpdns.org/api/v1

# Google Maps key (Android + iOS). Client key restricted by app signature /
# bundle id — safe to ship in the binary. Requires Maps SDK + billing enabled.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# DNI verification mode:
#   demo    -> local simulation, never exposes the Didit API key
#   backend -> calls POST /identity/verify-dni (backend proxies Didit server-side)
EXPO_PUBLIC_DNI_MODE=demo

# Filled automatically by `eas init`.
EAS_PROJECT_ID=
